---
import Base from './Base.astro';
import { isoDay, humanDay } from '../lib/date';

interface Props {
  title: string;
  date: Date;
  description?: string;
  image?: string;
}

const { title, date, description, image } = Astro.props;
const iso = isoDay(date);
const human = humanDay(date);
---
<Base title={title} description={description} image={image} type="article" published={date}>
  <article>
    <header class="post-header">
      <time datetime={iso}>{human}</time>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
